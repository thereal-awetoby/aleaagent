# Alea Agent. Copy to .env. Never commit secrets.

# true  = fixtures + template text, runs fully offline
# false = live data (Zetaris, or direct public APIs) and Nightshift for prose
SAMPLE_MODE=true
PORT=8000
# 127.0.0.1 keeps the app private to this computer. Use 0.0.0.0 to open it to your network.
HOST=127.0.0.1

# crypto and equities: sources must agree within this many percentage points to count as aligned.
# (forex: 0.5% of the midpoint, defi gas: 15%, weather: 2.0 C are set in src/domains.ts)
SPREAD_TOLERANCE=1.0

# Meterless Nightshift (the AI hotspot). Copy both values from Nightshift > Console.
# The NVIDIA key stays in Nightshift's Providers tab, never here.
# METERLESS_MODEL: meterless/auto, or pin a Nemotron-backed route listed by `npm run check`.
METERLESS_BASE_URL=
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=meterless/fast
# Optional: route for the judge step (defaults to METERLESS_MODEL). Set to a Nemotron route to pin the judge to Nemotron.
METERLESS_JUDGE_MODEL=
# Optional: how long one model call may take, in ms (default 45000). Raise it only for slow models like Nemotron Ultra.
# Recommended: meterless/fast for both writer and judge (Nemotron Lightning: quick and low cost for short texts).
METERLESS_TIMEOUT_MS=

# Zetaris (local Docker install). Create the API key yourself in the Zetaris web interface.
# Org ID is 1 on a local install. See docs/zetaris.md.
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=
ZETARIS_TABLE=alea.alea_readings

# Direct public fallback when SAMPLE_MODE=false and Zetaris is not configured
COINGECKO_BASE=https://api.coingecko.com/api/v3

# Optional keys for live mode. Leave empty and that source shows "no key"; nothing crashes.
# Sample mode (SAMPLE_MODE=true) never uses them. Values stay in your local .env only.
#   FINNHUB_API_KEY, ALPHAVANTAGE_API_KEY -> equities (yahoo needs no key; with both keys all 3 equity sources answer)
#   ETHERSCAN_API_KEY                      -> defi eth-gas
#   OPENWEATHER_API_KEY                    -> weather (new keys can take up to 2 hours to activate)
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
ETHERSCAN_API_KEY=
OPENWEATHER_API_KEY=
